.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(12, 30, 25, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10000;
  animation: fade 0.18s ease-out;
}

.sheet {
  position: relative;
  width: 560rpx;
  margin: 0 48rpx;
  background: #ffffff;
  border-radius: 36rpx;
  padding: 44rpx 40rpx 36rpx;
  text-align: center;
  overflow: hidden;
  animation: pop 0.24s cubic-bezier(0.2, 1.2, 0.4, 1);
}

.halo {
  position: absolute;
  top: -160rpx;
  left: 50%;
  margin-left: -220rpx;
  width: 440rpx;
  height: 440rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(46, 207, 166, 0.22), rgba(46, 207, 166, 0));
}

.ability-halo {
  opacity: 0.22;
}

.kicker {
  position: relative;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: #93a29c;
}

.emoji {
  position: relative;
  margin-top: 16rpx;
  font-size: 56rpx;
  line-height: 1;
}

.growth {
  position: relative;
  margin-top: 16rpx;
  font-size: 84rpx;
  font-weight: 800;
  line-height: 1;
  color: #12a97f;
  letter-spacing: -2rpx;
}

.unit {
  position: relative;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #93a29c;
  letter-spacing: 4rpx;
}

.line {
  position: relative;
  margin-top: 26rpx;
  font-size: 26rpx;
  color: #43534d;
}

.tags {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 22rpx;
}

.tag {
  margin: 8rpx 6rpx 0;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  font-size: 21rpx;
  color: #4a5c56;
  background: #f3f7f5;
}

.tag.mint {
  color: #12a97f;
  background: #e9f8f2;
}

.tag.gold {
  color: #c98414;
  background: #fff5e3;
}

.badge {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  margin: 22rpx auto 0;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-emoji {
  font-size: 60rpx;
  line-height: 1;
}

.ability-name {
  position: relative;
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #17211e;
}

.levels {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
}

.from {
  font-size: 28rpx;
  color: #93a29c;
  font-weight: 600;
}

.arrow {
  margin: 0 16rpx;
  font-size: 26rpx;
  color: #c5d0cc;
}

.to {
  font-size: 36rpx;
  font-weight: 800;
}

.exp-bar {
  position: relative;
  margin: 28rpx 12rpx 0;
  height: 14rpx;
  border-radius: 8rpx;
  background: #eef4f1;
  overflow: hidden;
}

.exp-fill {
  height: 100%;
  border-radius: 8rpx;
}

.exp-text {
  position: relative;
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #a3b0ab;
}

.advice {
  position: relative;
  margin-top: 22rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: #f6faf8;
  font-size: 24rpx;
  line-height: 1.55;
  color: #4a5c56;
  text-align: left;
}

.btn {
  position: relative;
  margin-top: 34rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #2ecfa6 0%, #12a97f 100%);
  box-shadow: 0 12rpx 26rpx rgba(18, 169, 127, 0.26);
}

@keyframes fade {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes pop {
  from {
    opacity: 0;
    transform: scale(0.9) translateY(14rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}
