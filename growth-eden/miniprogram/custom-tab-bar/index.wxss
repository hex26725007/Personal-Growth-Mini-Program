.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid #eef3f1;
  box-shadow: 0 -6rpx 22rpx rgba(21, 88, 68, 0.04);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 112rpx;
}

.tab-emoji {
  font-size: 40rpx;
  line-height: 1;
  transition: transform 0.18s ease;
}

.tab-emoji.on {
  transform: translateY(-2rpx) scale(1.08);
}

.tab-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #93a29c;
  transition: color 0.2s ease;
}

.tab-label.on {
  color: #12a97f;
  font-weight: 600;
}
