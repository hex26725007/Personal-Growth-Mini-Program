<view class="tabbar">
  <view
    class="tab"
    wx:for="{{list}}"
    wx:key="text"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <text class="tab-emoji {{selected === index ? 'on' : ''}}">{{item.emoji}}</text>
    <view class="tab-label {{selected === index ? 'on' : ''}}">{{item.text}}</view>
  </view>
</view>
