/* ===== 我的 ===== */
.profile-card {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  padding: 36rpx 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f2fbf7 100%);
  box-shadow: 0 8rpx 26rpx rgba(21, 88, 68, 0.05);
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #31cfa6, #12a97f);
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 22rpx rgba(18, 169, 127, 0.26);
  flex-shrink: 0;
}

.p-main {
  flex: 1;
  min-width: 0;
  padding-left: 24rpx;
}

.p-name-row {
  display: flex;
  align-items: center;
}

.p-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #17211e;
}

.p-edit {
  margin-left: 14rpx;
  padding: 2rpx 14rpx;
  border-radius: 12rpx;
  font-size: 18rpx;
  color: #12a97f;
  background: #e9f8f2;
}

.p-sub {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #93a29c;
}

.p-lv {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 18rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #12a97f;
  background: #e9f8f2;
}

/* 数据统计 */
.stats {
  display: flex;
  margin-top: 24rpx;
  padding: 30rpx 8rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 26rpx rgba(21, 88, 68, 0.045);
}

.stat {
  flex: 1;
  text-align: center;
  position: relative;
}

.stat + .stat::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 1rpx;
  background: #f0f4f2;
}

.stat-num {
  font-size: 38rpx;
  font-weight: 800;
  color: #17211e;
  line-height: 1.2;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 19rpx;
  color: #a3b0ab;
}

.stat-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  font-size: 19rpx;
  color: #a9b6b1;
}

.sep {
  margin: 0 10rpx;
  color: #d6e0dc;
}

/* 图表 */
.chart-card {
  margin-top: 24rpx;
}

.sec-hint {
  font-size: 20rpx;
  color: #a3b0ab;
}

.chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 28rpx;
  height: 260rpx;
}

.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.bar {
  width: 26rpx;
  border-radius: 13rpx;
  background: #dcf0e8;
  transition: height 0.45s ease;
}

.bar.on {
  background: linear-gradient(180deg, #35d2aa, #12a97f);
}

.bar-label {
  margin-top: 14rpx;
  font-size: 19rpx;
  color: #b0bcb7;
}

.bar-label.on {
  color: #12a97f;
  font-weight: 600;
}

/* 设置列表 */
.list {
  margin-top: 24rpx;
  padding: 8rpx 32rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  border-bottom: 1rpx solid #f3f7f5;
}

.row.last {
  border-bottom: none;
}

.row-left {
  display: flex;
  align-items: center;
}

.row-ico {
  margin-right: 18rpx;
}

.row-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #17211e;
}

.row-right {
  display: flex;
  align-items: center;
}

.row-val {
  font-size: 23rpx;
  color: #9aa8a3;
  margin-right: 6rpx;
}

.sync-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  background: #c8d4d0;
}

.sync-dot.ok {
  background: #17bf93;
}

.sync-dot.warn {
  background: #f0a02a;
}

.sync-dot.err {
  background: #ef6c4d;
}

.version {
  margin-top: 40rpx;
  text-align: center;
  font-size: 19rpx;
  color: #bcc7c3;
}
