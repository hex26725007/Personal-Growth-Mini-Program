/* ===== 我的（参考设计稿） ===== */

.hero {
  margin-top: 8rpx;
  padding: 36rpx 32rpx 28rpx;
  border-radius: 32rpx;
  background: linear-gradient(145deg, #ffffff 0%, #e8f9f2 55%, #d4f3e8 100%);
  box-shadow: 0 10rpx 28rpx rgba(21, 88, 68, 0.07);
}

.hero-head {
  display: flex;
  align-items: center;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  width: 120rpx;
  height: 120rpx;
  min-height: 120rpx;
  border: none;
  border-radius: 60rpx;
  overflow: hidden;
  background: transparent;
  line-height: normal;
  flex-shrink: 0;
  display: block;
}

.avatar-btn::after {
  display: none;
  border: none;
}

.avatar-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  overflow: hidden;
  border: 4rpx solid #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(18, 169, 127, 0.22);
  box-sizing: border-box;
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 60rpx;
}

.avatar-fallback {
  width: 100%;
  height: 100%;
  border-radius: 60rpx;
  background: linear-gradient(135deg, #31cfa6, #12a97f);
  color: #ffffff;
  font-size: 46rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.hero-main {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
}

.name-input {
  font-size: 36rpx;
  font-weight: 700;
  color: #17211e;
  height: 52rpx;
  line-height: 52rpx;
}

.level-badge {
  display: inline-block;
  margin-top: 12rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #12a97f;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 4rpx 12rpx rgba(18, 169, 127, 0.1);
}

.gear-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: #5e706a;
  flex-shrink: 0;
}

.hero-stats {
  display: flex;
  margin-top: 28rpx;
  padding: 26rpx 12rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
}

.h-stat {
  flex: 1;
  text-align: center;
  position: relative;
}

.h-stat + .h-stat::before {
  content: '';
  position: absolute;
  left: 0;
  top: 10rpx;
  bottom: 10rpx;
  width: 1rpx;
  background: #edf2ef;
}

.h-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #17211e;
  line-height: 1.15;
}

.h-unit {
  margin-left: 4rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #12a97f;
}

.h-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #93a29c;
}

.menu-card {
  margin-top: 24rpx;
  padding: 8rpx 32rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 26rpx rgba(21, 88, 68, 0.045);
}

.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 108rpx;
  border-bottom: 1rpx solid #f3f7f5;
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-ico {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 22rpx;
}

.menu-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #17211e;
}

.chart-card {
  margin-top: 24rpx;
}

.sec-hint {
  font-size: 20rpx;
  color: #a3b0ab;
}

.chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 28rpx;
  height: 260rpx;
}

.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.bar {
  width: 26rpx;
  border-radius: 13rpx;
  background: #dcf0e8;
  transition: height 0.45s ease;
}

.bar.on {
  background: linear-gradient(180deg, #35d2aa, #12a97f);
}

.bar-label {
  margin-top: 14rpx;
  font-size: 19rpx;
  color: #b0bcb7;
}

.bar-label.on {
  color: #12a97f;
  font-weight: 600;
}

.manifesto-card {
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(21, 88, 68, 0.04);
}

.mf-head {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.mf-ico {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.mf-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #17211e;
}

.mf-text {
  font-size: 26rpx;
  line-height: 1.65;
  color: #5e706a;
}

.mf-edit {
  margin-top: 22rpx;
  font-size: 22rpx;
  color: #12a97f;
  text-align: right;
}

.version {
  margin-top: 40rpx;
  margin-bottom: 16rpx;
  text-align: center;
  font-size: 19rpx;
  color: #bcc7c3;
}
