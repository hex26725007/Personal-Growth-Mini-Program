<page-shell title="我的">

  <view class="hero">
    <view class="hero-head">
      <button
        class="avatar-btn"
        open-type="chooseAvatar"
        bind:chooseavatar="onChooseAvatar"
        hover-class="none"
      >
        <view class="avatar-ring">
          <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
          <view wx:else class="avatar-fallback">{{avatarChar}}</view>
        </view>
      </button>

      <view class="hero-main">
        <input
          class="name-input"
          type="nickname"
          placeholder="点击使用微信昵称"
          value="{{vm.nickname}}"
          bindblur="onNicknameBlur"
        />
        <view class="level-badge">Lv.{{vm.level}} {{vm.levelTitle}}</view>
      </view>

      <view class="gear-btn" bindtap="onSettings" hover-class="hover-dim">⚙</view>
    </view>

    <view class="hero-stats">
      <view class="h-stat">
        <view class="h-num">{{vm.totalGrowth}}</view>
        <view class="h-label">成长值</view>
      </view>
      <view class="h-stat">
        <view class="h-num">{{vm.streak}}<text class="h-unit">天</text></view>
        <view class="h-label">连续打卡</view>
      </view>
      <view class="h-stat">
        <view class="h-num">{{vm.completedCount}}<text class="h-unit">个</text></view>
        <view class="h-label">完成任务</view>
      </view>
    </view>
  </view>

  <view class="menu-card">
    <view
      class="menu-row"
      wx:for="{{menus}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onMenu"
      hover-class="hover-dim"
    >
      <view class="menu-left">
        <view class="menu-ico" style="background:{{item.bg}}">{{item.emoji}}</view>
        <text class="menu-title">{{item.title}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="card chart-card" id="stats-chart">
    <view class="sec-head">
      <text class="sec-title">近 7 天成长</text>
      <text class="sec-hint">共 {{weekTotal}} 成长值</text>
    </view>
    <view class="chart">
      <view class="bar-col" wx:for="{{vm.weekBars}}" wx:key="date">
        <view class="bar-wrap">
          <view class="bar {{item.today ? 'on' : ''}}" style="height:{{item.height}}%"></view>
        </view>
        <text class="bar-label {{item.today ? 'on' : ''}}">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="manifesto-card">
    <view class="mf-head">
      <text class="mf-ico">🏅</text>
      <text class="mf-title">我的进化宣言</text>
    </view>
    <view class="mf-text">{{manifesto}}</view>
    <view class="mf-edit" bindtap="onEditManifesto" hover-class="hover-dim">编辑宣言</view>
  </view>

  <view class="version">个人成长进化乐园 · MVP 0.1</view>

</page-shell>
